generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  student
  buddy
  admin
}

enum GameType {
  quiz
  wordle
  connections
}

enum Difficulty {
  easy
  moderate
  hard
}

// ─── Core Models ─────────────────────────────────────────────────────────────

model User {
  id          String  @id @default(uuid())
  name        String
  email       String  @unique
  petName     String? @map("pet_name")
  city        String?
  phoneNumber String? @map("phone_number")

  // Meta
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  onboardedOn DateTime? @map("onboarded_on")

  // Stored as JSON — interests from both onboarding questions
  interests          Json? // { question1: string[], question2: string[] }
  // Array of Org IDs the student liked
  organisationsLiked Json? @map("organisations_liked") // string[]
  // Submitted document identifiers
  documentsSubmitted Json? @map("documents_submitted") // string[]

  // Flags
  isOnboarded    Boolean @default(false) @map("is_onboarded")
  isTourComplete Boolean @default(false) @map("is_tour_complete")
  isInternational Boolean @default(false) @map("is_international")

  // Module tracking
  // { [moduleId]: { isRead: bool, isQuizDone: bool, isWordleDone: bool, isConnectionsDone: bool } }
  modulesStatus Json? @map("modules_status")
  // { [moduleId]: { quiz: { score: number, answers: any[] }, wordle: { score: number }, connections: { score: number } } }
  moduleScores  Json? @map("module_scores")

  // Buddy self-relation
  buddyId          String? @map("buddy_id")
  buddy            User?   @relation("BuddyRelation", fields: [buddyId], references: [id])
  assignedStudents User[]  @relation("BuddyRelation")

  // Utility relations
  chatSessions     ChatSession[]
  timeSessions     TimeSession[]
  mascotDismissals MascotDismissal[]

  @@map("users")
}

model Module {
  id          String  @id @default(uuid())
  // URL-friendly identifier used in routes (/modules/[slug]) and to locate markdown
  slug        String  @unique
  title       String
  icon        String?
  description String  @db.Text
  isMandatory Boolean @default(false) @map("is_mandatory")
  // Display order in the modules list
  orderIndex  Int     @default(0) @map("order_index")
  // Optional journey/milestone grouping label (e.g. "Academics", "Residence Life")
  journeyMilestone String? @map("journey_milestone")

  // Rich text content (MD) or a path to the MD file
  content String @db.LongText

  // Analytics counter — incremented each time a student completes the module
  completionCount Int @default(0) @map("completion_count")

  // Relations
  games        Game[]
  timeSessions TimeSession[]

  @@map("modules")
}

model Game {
  id            String     @id @default(uuid())
  moduleId      String     @map("module_id")
  type          GameType
  title         String
  difficulty    Difficulty @default(easy)
  pointsValue   Int        @default(0) @map("points_value")
  estimatedMins Int        @default(0) @map("estimated_mins")
  // Order of the game within its module's activity list
  orderIndex    Int        @default(0) @map("order_index")

  // Type-specific payload:
  //   quiz:        { questions: [{ q, options, answer }] }
  //   connections: { groups: [{ label, color, items: string[] }] }
  //   wordle:      { word, maxAttempts, hint }
  config Json

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  // A module has at most one game of each type (matches the per-type progress flags on User)
  @@unique([moduleId, type])
  @@index([moduleId])
  @@map("games")
}

model Org {
  id          String @id @default(uuid())
  name        String
  tags        Json   // string[]
  logo        String @db.Text // Cloudinary link
  socials     Json   // { instagram?: string, twitter?: string, … }
  description String @db.Text

  @@map("orgs")
}

// ─── Utility / Feature Tables (kept for future use) ──────────────────────────

model FaqDocument {
  id        String   @id @default(uuid())
  title     String
  category  String
  content   String   @db.LongText
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("faq_documents")
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  messages  Json     // [{ role, content, timestamp }]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_sessions")
}

model TimeSession {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  date         DateTime @db.Date
  durationMins Int      @map("duration_mins")
  moduleId     String?  @map("module_id")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  @@map("time_sessions")
}

model MascotDismissal {
  userId      String   @map("user_id")
  triggerKey  String   @map("trigger_key")
  dismissedAt DateTime @default(now()) @map("dismissed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, triggerKey])
  @@map("mascot_dismissals")
}
